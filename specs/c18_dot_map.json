            "t": [
              "Densest band: the",
              "south-east coast,",
              "Brisbane to Adelaide"
            ],
            "align": "left",
            "rlon": 156.0,
            "rlat": -39.0
          },
          {
            "lon": 103.5,
            "lat": -36.0,
            "tlon": 115.6,
            "tlat": -32.3,
            "t": [
              "Perth: the only",
              "major cluster",
              "in the west"
            ],
            "align": "left",
            "rlon": 105.25,
            "rlat": -35.3
          }
        ]
