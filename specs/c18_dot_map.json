        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#8A4B12",
        "lineHeight": 15,
        "align": "left",
        "baseline": "middle",
        "dx": 4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
