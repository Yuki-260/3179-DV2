{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Public Sans",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "labelColor": "#3b4a4d",
      "titleColor": "#3b4a4d",
      "domainColor": "#b9c0bb",
      "tickColor": "#b9c0bb",
      "gridColor": "#e3e6e1",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#3b4a4d",
      "titleColor": "#3b4a4d"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 19,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#16262B",
      "subtitleFont": "Public Sans",
      "subtitleColor": "#5b6a6c",
      "subtitleFontSize": 13,
      "subtitlePadding": 6,
      "offset": 12
    }
  },
  "width": 860,
  "height": 620,
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": 945
  },
  "title": {
    "text": "Every museum OpenStreetMap knows about, dot by dot",
    "subtitle": "1,312 named museums across Australia: density shows where they actually cluster"
  },
  "layer": [
    {
      "data": {
        "url": "data/states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E4E8E2",
        "stroke": "#fff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/museums_national.topojson",
        "format": {
          "type": "topojson",
          "feature": "museums"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#14524B",
        "fillOpacity": 0.45,
        "stroke": null,
        "size": 22
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Museum"
          },
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.museum_type",
            "type": "nominal",
            "title": "Type"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 106.5,
            "lat": -16.5,
            "tlon": 119.5,
            "tlat": -24.5,
            "t": [
              "Vast interior:",
              "very few museums,",
              "little population"
            ],
            "align": "left",
            "rlon": 113.5,
            "rlat": -18.2
          },
          {
            "lon": 156.0,
            "lat": -39.0,
            "tlon": 151.2,
            "tlat": -36.0,
            "t": [
              "Densest band: the",
              "south-east coast,",
              "Brisbane to Adelaide"
            ],
            "align": "left",
            "rlon": 156.0,
            "rlat": -39.0
          },
          {
            "lon": 103.5,
            "lat": -36.0,
            "tlon": 115.6,
            "tlat": -32.3,
            "t": [
              "Perth: the only",
              "major cluster",
              "in the west"
            ],
            "align": "left",
            "rlon": 105.25,
            "rlat": -35.3
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#8A4B12",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ],
        "opacity": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "rlon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "rlat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "tlon"
        },
        "latitude2": {
          "field": "tlat"
        }
      }
    },
    {
      "data": {
        "values": [
