        "align": "left",
        "baseline": "middle",
        "dx": 24,
        "dy": -18,
        "color": "#161E2B"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.r == datum.hi || datum.r == datum.lo"},
        {"filter": "datum.state == 'ACT'"},
        {
          "calculate": "datum.r == datum.hi ? '▲ Highest' : '▼ Lowest'",
          "as": "tag"
        },
        {"calculate": "154.3", "as": "alon"},
        {"calculate": "-36.2", "as": "alat"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "dy": -27,
        "color": "#161E2B"
      },
      "encoding": {
        "longitude": {"field": "alon", "type": "quantitative"},
        "latitude": {"field": "alat", "type": "quantitative"},
        "text": {"field": "tag"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"filter": "datum.state == 'ACT'"},
        {"calculate": "149.95", "as": "slon"},
        {"calculate": "-35.6", "as": "slat"},
        {"calculate": "153.8", "as": "elon"},
        {"calculate": "-36.2", "as": "elat"}
      ],
      "mark": {
        "type": "rule",
        "stroke": "#161E2B",
        "strokeWidth": 1,
        "strokeDash": [3, 3],
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {"field": "slon", "type": "quantitative"},
        "latitude": {"field": "slat", "type": "quantitative"},
        "longitude2": {"field": "elon"},
        "latitude2": {"field": "elat"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"filter": "datum.state == 'ACT'"},
        {"calculate": "149.05", "as": "slon"},
        {"calculate": "-35.5", "as": "slat"}
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 520,
        "filled": false,
        "stroke": "#C9862B",
        "strokeWidth": 3
      },
      "encoding": {
        "longitude": {"field": "slon", "type": "quantitative"},
        "latitude": {"field": "slat", "type": "quantitative"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"filter": "datum.state == 'ACT'"},
        {"calculate": "149.05", "as": "slon"},
        {"calculate": "-35.5", "as": "slat"}
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 520,
        "filled": false,
        "stroke": "#161E2B",
        "strokeWidth": 1,
        "strokeDash": [2, 2]
      },
      "encoding": {
        "longitude": {"field": "slon", "type": "quantitative"},
        "latitude": {"field": "slat", "type": "quantitative"}
      }
    }
  ]
