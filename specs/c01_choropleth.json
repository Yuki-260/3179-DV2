{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Public Sans",
    "background": null,
    "view": {"stroke": null},
    "legend": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#3B424D",
      "titleColor": "#3B424D"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#161E2B",
      "subtitleFont": "Public Sans",
      "subtitleColor": "#5b6a6c",
      "subtitleFontSize": 13,
      "subtitlePadding": 6,
      "offset": 12
    }
  },
  "width": 900,
  "height": 620,
  "projection": {
    "type": "albers",
    "rotate": [-132, 0, 0],
    "center": [0, -27],
    "parallels": [-18, -36],
    "scale": 945
  },
  "title": {
    "text": "Where Australia goes out culturally",
    "subtitle": [
      "Share of people aged 15+ who attended in 2021–22.",
      "A rate per 100 people, so states compare fairly."
    ]
  },
  "params": [
    {
      "name": "VenueSelect",
      "value": "museum_rate",
      "bind": {
        "input": "select",
        "options": [
          "museum_rate",
          "gallery_rate",
          "library_rate",
          "cinema_rate"
        ],
        "labels": ["Museums", "Art galleries", "Libraries/archives", "Cinemas"],
        "name": "Show attendance for: "
      }
    }
  ],
  "layer": [
    {
      "data": {"graticule": {"step": [10, 10]}},
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#DDE1DB",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/states.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "calculate": "'Data not available for ' + datum.properties.STATE_NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E4E8E2",
        "stroke": "#F3F4F0",
        "strokeWidth": 1.2
      },
      "encoding": {"tooltip": {"field": "note"}}
    },
    {
      "data": {
        "url": "data/states.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {"url": "data/states.csv"},
            "key": "name",
            "fields": [
              "museum_rate",
              "gallery_rate",
              "library_rate",
              "cinema_rate",
              "state",
              "museum_k"
            ]
          }
        },
        {"calculate": "datum[VenueSelect]", "as": "Selected Rate"}
      ],
      "mark": {"type": "geoshape", "stroke": "#F3F4F0", "strokeWidth": 1.2},
      "encoding": {
        "color": {
          "field": "Selected Rate",
          "type": "quantitative",
          "scale": {"range": ["#DCE2EB", "#142D52"]},
          "legend": {
            "title": "Attendance rate (% of people 15+)",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 225,
            "titleLimit": 300
          }
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "Selected Rate", "title": "Attendance rate (%)"},
          {"field": "museum_k", "title": "Museum visitors ('000)"}
        ]
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"filter": "datum.state != 'ACT' && datum.state != 'TAS'"},
        {"calculate": "datum[VenueSelect]", "as": "Selected Rate"},
        {
          "calculate": "datum.state + ' ' + format(datum['Selected Rate'], '.1f') + '%'",
          "as": "dynamic_label"
        }
      ],
      "mark": {"type": "text", "fontSize": 13, "fontWeight": 600},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "dynamic_label"},
        "color": {
          "condition": {
            "test": "luminance(scale('color', datum['Selected Rate'])) < 0.45",
            "value": "#fff"
          },
          "value": "#161E2B"
        }
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"filter": "datum.state == 'TAS'"},
        {"calculate": "datum[VenueSelect]", "as": "Selected Rate"},
        {
          "calculate": "datum.state + ' ' + format(datum['Selected Rate'], '.1f') + '%'",
          "as": "dynamic_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "align": "left",
        "baseline": "middle",
        "dx": 24
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "dynamic_label"},
        "color": {"value": "#161E2B"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"filter": "datum.state == 'ACT'"},
        {"calculate": "datum[VenueSelect]", "as": "Selected Rate"},
        {
          "calculate": "['Canberra (ACT)', format(datum['Selected Rate'], '.1f') + '%']",
          "as": "dynamic_label"
        },
        {"calculate": "154.3", "as": "alon"},
        {"calculate": "-36.2", "as": "alat"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "align": "left",
        "baseline": "middle",
        "lineHeight": 15
      },
      "encoding": {
        "longitude": {"field": "alon", "type": "quantitative"},
        "latitude": {"field": "alat", "type": "quantitative"},
        "text": {"field": "dynamic_label"},
        "color": {"value": "#161E2B"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.state == 'NSW'"},
        {
          "calculate": "['Gap between the highest and','lowest state: ' + format(datum.hi - datum.lo, '.1f') + ' percentage points']",
          "as": "gap"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#161E2B",
        "lineHeight": 18,
        "x": 880,
        "y": 40
      },
      "encoding": {"text": {"field": "gap"}}
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.r == datum.hi || datum.r == datum.lo"},
        {"filter": "datum.state != 'ACT' && datum.state != 'TAS'"},
        {
          "calculate": "datum.r == datum.hi ? '▲ Highest' : '▼ Lowest'",
          "as": "tag"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": -24,
        "color": "#F3F4F0",
        "stroke": "#F3F4F0",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.r == datum.hi || datum.r == datum.lo"},
        {"filter": "datum.state == 'TAS'"},
        {
          "calculate": "datum.r == datum.hi ? '▲ Highest' : '▼ Lowest'",
          "as": "tag"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "dx": 24,
        "dy": -18,
        "color": "#F3F4F0",
        "stroke": "#F3F4F0",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.r == datum.hi || datum.r == datum.lo"},
        {"filter": "datum.state == 'ACT'"},
        {
          "calculate": "datum.r == datum.hi ? '▲ Highest' : '▼ Lowest'",
          "as": "tag"
        },
        {"calculate": "154.3", "as": "alon"},
        {"calculate": "-36.2", "as": "alat"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "dy": -27,
        "color": "#F3F4F0",
        "stroke": "#F3F4F0",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {"field": "alon", "type": "quantitative"},
        "latitude": {"field": "alat", "type": "quantitative"},
        "text": {"field": "tag"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.r == datum.hi || datum.r == datum.lo"},
        {"filter": "datum.state != 'ACT' && datum.state != 'TAS'"},
        {
          "calculate": "datum.r == datum.hi ? '▲ Highest' : '▼ Lowest'",
          "as": "tag"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": -24,
        "color": "#161E2B"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag"}
      }
    },
    {
      "data": {"url": "data/states.csv"},
      "transform": [
        {"calculate": "datum[VenueSelect]", "as": "r"},
        {
          "joinaggregate": [
            {"op": "max", "field": "r", "as": "hi"},
            {"op": "min", "field": "r", "as": "lo"}
          ]
        },
        {"filter": "datum.r == datum.hi || datum.r == datum.lo"},
        {"filter": "datum.state == 'TAS'"},
        {
          "calculate": "datum.r == datum.hi ? '▲ Highest' : '▼ Lowest'",
          "as": "tag"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
