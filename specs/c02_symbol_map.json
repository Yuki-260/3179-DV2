{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Public Sans",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "labelColor": "#3b4a4d",
      "titleColor": "#3b4a4d",
      "domainColor": "#b9c0bb",
      "tickColor": "#b9c0bb",
      "gridColor": "#e3e6e1",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 600,
      "labelColor": "#3b4a4d",
      "titleColor": "#3b4a4d"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 19,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#16262B",
      "subtitleFont": "Public Sans",
      "subtitleColor": "#5b6a6c",
      "subtitleFontSize": 13,
      "subtitlePadding": 6,
      "offset": 12
    }
  },
  "width": 860,
  "height": 620,
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": 945
  },
  "title": {
    "text": "Big states bring the crowds, small states bring the enthusiasm",
    "subtitle": "Circle size: Museum visitors (thousands). Colour: visitors per 1,000 residents."
  },
  "params": [
    {
      "name": "Min_Rate",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 31,
        "step": 1,
        "name": "Minimum attendance rate (%): "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "graticule": {
          "step": [
            10,
            10
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#DDE1DB",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/states.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E4E8E2",
        "stroke": "#fff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/states.csv"
      },
      "transform": [
        {
          "filter": "datum.museum_rate >= Min_Rate"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "#fff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "museum_k",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1000
            ],
            "range": [
              0,
              6500
            ]
          },
          "legend": {
            "title": "Museum visitors (thousands)",
            "orient": "bottom-left",
            "values": [
              100,
              500,
              900
            ]
          }
        },
        "color": {
          "field": "museum_per_1000",
          "type": "quantitative",
          "scale": {
            "domain": [
              100,
              230
            ],
            "range": [
              "#F1DDB8",
              "#A3560A"
            ]
          },
          "legend": {
            "title": "Per 1,000 residents",
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "museum_k",
            "title": "Visitors ('000)"
          },
          {
            "field": "pop15_k",
            "title": "Population ('000)"
          },
          {
            "field": "museum_per_1000",
            "title": "Visitors per 1,000 residents"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.csv"
      },
      "transform": [
        {
          "filter": "datum.museum_k>500 && datum.museum_rate >= Min_Rate"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13.5,
        "fontWeight": 600,
        "color": "#16262B"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ]
}