          "from": {
            "data": {
              "url": "data/states.csv"
            },
            "key": "state",
            "fields": [
              "name",
              "pop15_k",
              "museum_rate",
              "museum_k"
            ]
          }
        },
        {
          "calculate": "1.05 * sqrt(datum.pop15_k)",
          "as": "r"
        },
        {
          "filter": "datum.pop15_k < 1000"
        },
        {
          "calculate": "datum.x + datum.r + 6",
          "as": "lx"
        },
        {
          "calculate": "datum.state + '  ' + format(datum.museum_rate, '.1f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "align": "left",
        "baseline": "middle",
        "color": "#16262B"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "scale": null
