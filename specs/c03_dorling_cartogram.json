            "y": 183.0
          },
          {
            "state": "ACT",
            "x": 661.9,
            "y": 495.6
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/states.csv"
            },
            "key": "state",
            "fields": [
              "name",
              "pop15_k",
              "museum_rate",
              "museum_k"
            ]
          }
        },
        {
          "calculate": "1.05 * sqrt(datum.pop15_k)",
          "as": "r"
        },
        {
          "filter": "datum.pop15_k >= 1000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": 700,
        "dy": -8
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "state"
        },
        "color": {
          "condition": {
            "test": "datum.museum_rate > 22",
            "value": "#fff"
          },
          "value": "#16262B"
        }
      }
    },
    {
      "data": {
